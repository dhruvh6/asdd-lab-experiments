{
  "name": "campuseats-backend",
  "version": "1.0.0",
  "description": "CampusEats REST API - canteen pre-order and token system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "STORE=memory node --watch src/server.js",
    "test": "jest --ci --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.1"
  }
}
